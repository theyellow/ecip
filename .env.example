# EMCIP Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# --- Telegram API credentials (required for tdlib-adapter) ---
# Get from: https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Phone number with country code for Telegram authentication
# Can be set later via POST /api/auth/phone if not provided at startup
TELEGRAM_PHONE_NUMBER=

# --- Anthropic API key (required for LLM orchestrator) ---
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Kafka (optional overrides, defaults work with docker-compose) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:14003
