<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-intent-classifier-init" author="emcip-team">
        <comment>Initial schema for intent classifier service</comment>

        <createTable tableName="intent_classifications">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="message_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="chat_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="primary_intent" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="confidence" type="DECIMAL(3,2)">
                <constraints nullable="false"/>
            </column>
            <column name="all_intents" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="requires_policy_check" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_classifications_message" tableName="intent_classifications">
            <column name="message_id"/>
        </createIndex>

        <createIndex indexName="idx_classifications_chat" tableName="intent_classifications">
            <column name="chat_id"/>
        </createIndex>
    </changeSet>

    <include file="db/changelog/changes/003-create-intent-rules.xml"/>
    <include file="db/changelog/changes/004-create-intent-signal-config.xml"/>

</databaseChangeLog>
