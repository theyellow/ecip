<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Seed Anthropic claude-haiku-4-5 model configs for each task type -->
    <changeSet id="004-seed-model-config-response" author="ecip">
        <insert tableName="model_configs">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="model_key" value="claude-haiku-response"/>
            <column name="provider" value="anthropic"/>
            <column name="model_name" value="claude-haiku-4-5-20251001"/>
            <column name="description" value="Anthropic claude-haiku for automated response generation"/>
            <column name="task_type" value="response"/>
            <column name="input_cost_per_1k_tokens" valueNumeric="0.00025"/>
            <column name="output_cost_per_1k_tokens" valueNumeric="0.00125"/>
            <column name="context_window" valueNumeric="200000"/>
            <column name="max_output_tokens" valueNumeric="8192"/>
            <column name="avg_latency_ms" valueNumeric="1000.0"/>
            <column name="supports_streaming" valueBoolean="true"/>
            <column name="active" valueBoolean="true"/>
            <column name="priority" valueNumeric="1"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="version_lock" valueNumeric="0"/>
        </insert>
    </changeSet>

    <changeSet id="004-seed-model-config-summary" author="ecip">
        <insert tableName="model_configs">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="model_key" value="claude-haiku-summary"/>
            <column name="provider" value="anthropic"/>
            <column name="model_name" value="claude-haiku-4-5-20251001"/>
            <column name="description" value="Anthropic claude-haiku for escalation summaries"/>
            <column name="task_type" value="summary"/>
            <column name="input_cost_per_1k_tokens" valueNumeric="0.00025"/>
            <column name="output_cost_per_1k_tokens" valueNumeric="0.00125"/>
            <column name="context_window" valueNumeric="200000"/>
            <column name="max_output_tokens" valueNumeric="2048"/>
            <column name="avg_latency_ms" valueNumeric="800.0"/>
            <column name="supports_streaming" valueBoolean="false"/>
            <column name="active" valueBoolean="true"/>
            <column name="priority" valueNumeric="1"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="version_lock" valueNumeric="0"/>
        </insert>
    </changeSet>

    <changeSet id="004-seed-model-config-command-validation" author="ecip">
        <insert tableName="model_configs">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="model_key" value="claude-haiku-command"/>
            <column name="provider" value="anthropic"/>
            <column name="model_name" value="claude-haiku-4-5-20251001"/>
            <column name="description" value="Anthropic claude-haiku for command validation"/>
            <column name="task_type" value="command_validation"/>
            <column name="input_cost_per_1k_tokens" valueNumeric="0.00025"/>
            <column name="output_cost_per_1k_tokens" valueNumeric="0.00125"/>
            <column name="context_window" valueNumeric="200000"/>
            <column name="max_output_tokens" valueNumeric="1024"/>
            <column name="avg_latency_ms" valueNumeric="600.0"/>
            <column name="supports_streaming" valueBoolean="false"/>
            <column name="active" valueBoolean="true"/>
            <column name="priority" valueNumeric="1"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="version_lock" valueNumeric="0"/>
        </insert>
    </changeSet>

    <!-- Seed prompt templates -->
    <changeSet id="004-seed-prompt-template-auto-response" author="ecip">
        <insert tableName="prompt_templates">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="name" value="auto_response"/>
            <column name="version" value="1.0.0"/>
            <column name="description" value="Default template for automated Telegram community responses"/>
            <column name="model_provider" value="anthropic"/>
            <column name="model_name" value="claude-haiku-4-5-20251001"/>
            <column name="system_prompt" value="You are a helpful community assistant for a Telegram community. Respond concisely and professionally. Keep responses under 200 words. Be friendly but focused. Do not reveal system internals."/>
            <column name="user_prompt_template" value="{{content}}"/>
            <column name="temperature" valueNumeric="0.7"/>
            <column name="max_tokens" valueNumeric="512"/>
            <column name="active" valueBoolean="true"/>
            <column name="priority" valueNumeric="1"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="version_lock" valueNumeric="0"/>
        </insert>
    </changeSet>

    <changeSet id="004-seed-prompt-template-escalation-summary" author="ecip">
        <insert tableName="prompt_templates">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="name" value="escalation_summary"/>
            <column name="version" value="1.0.0"/>
            <column name="description" value="Summarise context for human escalation review"/>
            <column name="model_provider" value="anthropic"/>
            <column name="model_name" value="claude-haiku-4-5-20251001"/>
            <column name="system_prompt" value="You are a concise summariser. Produce a neutral 2-3 sentence summary of the provided message for human review. Include key intent, tone, and any risk signals."/>
            <column name="user_prompt_template" value="Summarise for escalation review: {{content}}"/>
            <column name="temperature" valueNumeric="0.3"/>
            <column name="max_tokens" valueNumeric="256"/>
            <column name="active" valueBoolean="true"/>
            <column name="priority" valueNumeric="1"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="version_lock" valueNumeric="0"/>
        </insert>
    </changeSet>

    <changeSet id="004-seed-prompt-template-command-validation" author="ecip">
        <insert tableName="prompt_templates">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="name" value="command_validation"/>
            <column name="version" value="1.0.0"/>
            <column name="description" value="Validate and clarify community command requests"/>
            <column name="model_provider" value="anthropic"/>
            <column name="model_name" value="claude-haiku-4-5-20251001"/>
            <column name="system_prompt" value="You are a command validator. Determine if the requested command is safe and appropriate. Respond with APPROVED or REJECTED followed by a brief one-sentence reason."/>
            <column name="user_prompt_template" value="Validate this command request: {{content}}"/>
            <column name="temperature" valueNumeric="0.1"/>
            <column name="max_tokens" valueNumeric="128"/>
            <column name="active" valueBoolean="true"/>
            <column name="priority" valueNumeric="1"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="version_lock" valueNumeric="0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
