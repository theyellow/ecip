<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002-create-model-cost-logs-table" author="ecip">
        <comment>Create model_cost_logs table for AI call cost tracking</comment>

        <createTable tableName="model_cost_logs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="request_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="model_provider" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="model_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_template_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="input_tokens" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="output_tokens" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="total_tokens" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="input_cost_usd" type="DECIMAL(10,6)">
                <constraints nullable="false"/>
            </column>
            <column name="output_cost_usd" type="DECIMAL(10,6)">
                <constraints nullable="false"/>
            </column>
            <column name="total_cost_usd" type="DECIMAL(10,6)">
                <constraints nullable="false"/>
            </column>
            <column name="latency_ms" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="error_message" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="source_event_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="conversation_id" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="version_lock" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="model_cost_logs"
                columnNames="request_id"
                constraintName="uk_model_cost_logs_request_id"/>

        <createIndex indexName="idx_model_cost_logs_event" tableName="model_cost_logs">
            <column name="source_event_id"/>
        </createIndex>

        <createIndex indexName="idx_model_cost_logs_model" tableName="model_cost_logs">
            <column name="model_name"/>
        </createIndex>

        <createIndex indexName="idx_model_cost_logs_created" tableName="model_cost_logs">
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_model_cost_logs_conversation" tableName="model_cost_logs">
            <column name="conversation_id"/>
        </createIndex>

        <createIndex indexName="idx_model_cost_logs_template" tableName="model_cost_logs">
            <column name="prompt_template_name"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
