<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-admin-api-init" author="emcip-team">
        <comment>Initial schema for admin API service</comment>

        <createTable tableName="admin_users">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(20)" defaultValue="ADMIN">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="last_login" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="group_profiles">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="telegram_chat_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="rules_enabled" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="auto_respond" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="moderation_level" type="VARCHAR(20)" defaultValue="MEDIUM">
                <constraints nullable="false"/>
            </column>
            <column name="welcome_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_group_profiles_chat" tableName="group_profiles">
            <column name="telegram_chat_id"/>
        </createIndex>
    </changeSet>

    <include file="db/changelog/changes/002-seed-admin-user.xml"/>
    <include file="db/changelog/changes/003-create-tenants-table.xml"/>
    <include file="db/changelog/changes/004-reset-admin-password.xml"/>
    <include file="db/changelog/changes/005-group-rules-default.xml"/>
    <include file="db/changelog/changes/006-telegram-config-and-group-tenant.xml"/>
    <include file="db/changelog/changes/007-telegram-accounts.xml"/>
    <include file="db/changelog/changes/008-account-watched-groups.xml"/>
    <include file="db/changelog/changes/009-rules-enabled-jsonb-to-text.xml"/>
    <include file="db/changelog/changes/010-telegram-accounts-add-tenant-id.xml"/>
    <include file="db/changelog/changes/011-refresh-tokens.xml"/>
    <include file="db/changelog/changes/012-admin-users-add-tenant.xml"/>
    <include file="db/changelog/changes/013-telegram-accounts-adapter-id.xml"/>

</databaseChangeLog>
