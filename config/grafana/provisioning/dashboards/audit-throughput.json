      "title": "Audit Event Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "datasource": { "type": "loki", "uid": "Loki" }, "expr": "sum(rate({service=\"moderation-service\"} |= \"ModerationFlag\" [5m]))", "legendFormat": "flags/s", "refId": "A" }],
      "title": "Moderation Flag Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
