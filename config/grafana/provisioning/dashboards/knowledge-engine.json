{
  "annotations": { "list": [] },
  "description": "EMCIP Knowledge Engine — extraction pipeline, vector search, graph operations",
  "editable": true,
  "id": null,
  "uid": "emcip-knowledge-engine",
  "title": "EMCIP Knowledge Engine",
  "tags": ["emcip", "knowledge", "prometheus"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Kafka Consumer Rate (knowledge.raw.messages)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "sum(rate(kafka_consumer_fetch_manager_records_consumed_total{service=\"knowledge-engine\"}[5m]))",
        "legendFormat": "messages/s",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "id": 2,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "sum(kafka_consumer_fetch_manager_records_lag{service=\"knowledge-engine\"}) by (topic)",
        "legendFormat": "{{topic}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 3,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "sum by (uri) (rate(http_server_requests_seconds_count{service=\"knowledge-engine\"}[1m]))",
        "legendFormat": "{{uri}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 4,
      "title": "HTTP Latency p95 (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service=\"knowledge-engine\"}[5m])))",
        "legendFormat": "{{uri}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 5,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "jvm_memory_used_bytes{area=\"heap\", service=\"knowledge-engine\"}",
        "legendFormat": "{{id}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 6,
      "title": "Knowledge Engine Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending" },
      "targets": [{ "datasource": { "type": "loki", "uid": "Loki" }, "expr": "{container=\"ecip-knowledge-engine\"}", "refId": "A" }]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "version": 1
}
