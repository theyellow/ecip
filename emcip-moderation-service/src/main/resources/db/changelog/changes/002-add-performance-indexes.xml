<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002-add-performance-indexes" author="phase5">
        <createIndex indexName="idx_moderation_rules_type_severity" tableName="moderation_rules">
            <column name="rule_type"/>
            <column name="severity"/>
        </createIndex>
        <createIndex indexName="idx_moderation_rules_created_at" tableName="moderation_rules">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
