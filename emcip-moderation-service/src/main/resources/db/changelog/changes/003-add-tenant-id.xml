<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="003-add-tenant-id" author="phase5">
        <addColumn tableName="moderation_rules">
            <column name="tenant_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex indexName="idx_moderation_rules_tenant" tableName="moderation_rules">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
