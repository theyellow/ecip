@startuml Sequence_Tenant_Propagation
' Purpose: X-Tenant-Id propagation through HTTP and Kafka paths
' Used in: architecture-guide.adoc - Security Architecture section

!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title X-Tenant-Id Propagation — HTTP and Kafka Paths

== HTTP Path (Servlet Services) ==

participant "HTTP Client" as Client
participant "TenantContextFilter\n(OncePerRequestFilter)" as TCF
participant "TenantContext\n(ThreadLocal)" as TC
participant "TenantFilterAspect\n(Spring AOP @Before)" as TFA
participant "JPA Repository\n(@Repository)" as Repo
database "PostgreSQL\n(Hibernate @Filter)" as DB

Client -> TCF : HTTP request\nX-Tenant-Id: <uuid>
activate TCF
TCF -> TC : setTenantId(uuid)
TCF -> TFA : (request continues)
TFA -> TFA : enableFilter("tenantFilter")\nsetParameter("tenantId", uuid)
TFA -> Repo : findAll()
Repo -> DB : SELECT * FROM ...\nWHERE tenant_id = ?
DB --> Repo : rows for this tenant only
Repo --> TFA : result
TFA --> TCF : response
TCF -> TC : clear()
TCF --> Client : HTTP response
deactivate TCF

== HTTP Path (Admin API — Reactive) ==

participant "HTTP Client" as AdminClient
participant "AdminTenantContextFilter\n(WebFilter)" as ATCF
participant "TenantContext\n(ThreadLocal)" as TC2
participant "Controller" as Ctrl
participant "Repository\n(R2DBC, scoped methods)" as R2Repo

AdminClient -> ATCF : HTTP request\nX-Tenant-Id: <uuid>\n[or ROLE_ADMIN JWT]
activate ATCF
alt Normal tenant call
    ATCF -> TC2 : setTenantId(uuid)
    ATCF -> Ctrl : request
    Ctrl -> R2Repo : findByIdAndTenantId(id, uuid)
else ROLE_ADMIN JWT
    ATCF -> TC2 : setAdminMode(true)
    ATCF -> Ctrl : request
    Ctrl -> R2Repo : findById(id) [unscoped]
end
R2Repo --> Ctrl : result
Ctrl --> ATCF : response
ATCF -> TC2 : clear()
ATCF --> AdminClient : HTTP response
deactivate ATCF

== Kafka Path ==

participant "Kafka Producer\n(any service)" as Prod
participant "TenantAwareKafkaSupport" as TAKS
queue "Kafka Topic" as Topic
participant "Kafka Consumer" as Cons
participant "TenantContext\n(ThreadLocal)" as TC3
participant "Service Method\n(+ TenantFilterAspect)" as DSvc
database "PostgreSQL" as DB2

Prod -> TAKS : addTenantHeader(record)
TAKS -> TAKS : read tenantId\nfrom TenantContext
TAKS -> Topic : ProducerRecord with\nheader tenant_id=<uuid>

Topic -> Cons : ConsumerRecord
Cons -> TAKS : bindTenantFromRecord(record)
TAKS -> TC3 : setTenantId(uuid)
Cons -> DSvc : invoke service method
DSvc -> DB2 : filtered query\nWHERE tenant_id = ?
DSvc --> Cons : result
Cons -> TC3 : clear() [finally]

@enduml
