@startuml Sequence_LLM_Orchestration
' Purpose: LLM orchestration flow — actual implemented flow via LiteLLM proxy
' Used in: architecture-guide.adoc - LLM Orchestration section

!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam wrapWidth 180

title LLM Orchestrator - Response Generation Flow

queue "policies.\ndecisions" as InTopic
participant "PolicyDecision\nConsumer" as Consumer
box "LLM Orchestrator Components" #LightCoral
    participant "LlmCall\nService" as LlmCall
    participant "LlmOrchestrator\nService" as OrchestratorSvc
    participant "LlmProviderConfig\nService" as ProviderSvc
    participant "KnowledgeContext\nEnricherService" as Enricher
    participant "KnowledgeEngine\nClient" as KnowledgeClient
    participant "OpenAiCompatible\nLlmClient" as LlmClient
    participant "CostTracking\nService" as CostTracker
end box
database "PostgreSQL" as DB
participant "Knowledge\nEngine :9088" as KnowledgeEngine
participant "LiteLLM\nProxy" as LiteLLM
queue "responses.\ngenerated" as OutTopic

== Event Ingestion ==
InTopic -> Consumer: PolicyDecisionEvent
activate Consumer
Consumer -> Consumer: Check decision (RESPOND / ESCALATE / EXECUTE call the LLM)

alt decision is BLOCK / REVIEW / ALLOW
    Consumer -> Consumer: Skip (no AI interaction)
else automated responses disabled (emcip.llm.automated-responses.enabled = false, default)
    Consumer -> Consumer: Log "automated responses disabled", skip LLM call
else RESPOND / ESCALATE / EXECUTE and enabled

    == Template + Model Config ==
    Consumer -> LlmCall: callForTask(taskType, templateName, userContent)
    activate LlmCall

    LlmCall -> OrchestratorSvc: getPromptTemplate(templateName)
    activate OrchestratorSvc
    OrchestratorSvc -> DB: SELECT prompt_templates WHERE name = ? AND active\n[tenantFilter: tenant_id = :tenant OR system = true]
    note right: System templates are global (ADR-009) -\nvisible to every tenant.
    DB --> OrchestratorSvc: PromptTemplate (or none -> skip LLM call)
    OrchestratorSvc --> LlmCall: PromptTemplate
    deactivate OrchestratorSvc

    LlmCall -> OrchestratorSvc: template.modelConfig, else selectModelForTask(taskType)
    activate OrchestratorSvc
    OrchestratorSvc -> DB: SELECT model_configs WHERE task_type = ?
    DB --> OrchestratorSvc: ModelConfig
    OrchestratorSvc --> LlmCall: ModelConfig
    deactivate OrchestratorSvc

    LlmCall -> OrchestratorSvc: renderPromptTemplate(template, vars)
    activate OrchestratorSvc
    OrchestratorSvc -> OrchestratorSvc: Substitute {{variables}} in template
    OrchestratorSvc --> LlmCall: rendered system prompt string
    deactivate OrchestratorSvc

    == Provider Config Lookup ==
    LlmCall -> ProviderSvc: getActiveProvider()
    activate ProviderSvc
    ProviderSvc -> DB: SELECT llm_provider_configs WHERE active = true
    DB --> ProviderSvc: LlmProviderConfig (baseUrl, apiKey)
    ProviderSvc --> LlmCall: LlmProviderConfig
    deactivate ProviderSvc

    == Knowledge Enrichment (optional) ==
    alt KNOWLEDGE_ENRICHMENT_ENABLED=true
        LlmCall -> Enricher: buildContext(userContent, tenantId)
        activate Enricher
        Enricher -> KnowledgeClient: search(query, "HYBRID", tenantId, maxResults)
        activate KnowledgeClient
        KnowledgeClient -> KnowledgeEngine: POST /api/knowledge/search
        activate KnowledgeEngine
        KnowledgeEngine --> KnowledgeClient: SearchResponse (DocumentResults with similarity scores)
        deactivate KnowledgeEngine
        KnowledgeClient --> Enricher: SearchResponse
        deactivate KnowledgeClient
        Enricher -> Enricher: Filter by relevanceThreshold, format context block
        Enricher --> LlmCall: context string (or "" if nothing above threshold)
        deactivate Enricher
        LlmCall -> LlmCall: Prepend context to userContent if non-blank
    else KNOWLEDGE_ENRICHMENT_ENABLED=false (default)
        LlmCall -> LlmCall: Use userContent as-is
    end

    == LLM Call ==
    LlmCall -> LlmClient: call(model, systemPrompt, enrichedContent, maxTokens, temp)
    activate LlmClient
    LlmClient -> LiteLLM: POST {baseUrl}/v1/chat/completions\n{model, messages, max_tokens, temperature}
    activate LiteLLM
    LiteLLM --> LlmClient: {choices[0].message.content,\nusage.prompt_tokens, usage.completion_tokens}
    deactivate LiteLLM
    LlmClient --> LlmCall: LlmResponse (content, inputTokens, outputTokens, modelUsed)
    deactivate LlmClient

    == Cost Logging ==
    LlmCall -> CostTracker: logSuccessfulCall(correlationId, taskType, model, inputTokens, outputTokens)
    activate CostTracker
    CostTracker -> DB: INSERT model_cost_logs\n(tenant_id = event tenant, else global sentinel)
    CostTracker --> LlmCall: logged
    deactivate CostTracker

    LlmCall --> Consumer: LlmResponse
    deactivate LlmCall

    == Response Publishing ==
    Consumer -> OutTopic: ResponseGeneratedEvent
end

deactivate Consumer

@enduml
