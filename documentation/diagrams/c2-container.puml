@startuml C2_Container_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' Purpose: Container-level view showing all 8 microservices, infrastructure, and event flows
' Used in: architecture.adoc - Container Architecture section

LAYOUT_WITH_LEGEND()

System_Boundary(ecip_platform, "EMCIP Platform") {

    ' Core Processing Pipeline (top row)
    Container(tdlib_adapter, "TDLib Adapter", "Java 21 / Spring Boot 4 / Port 9080", "Telegram client integration<br/>Event normalization<br/>TDLib JNI bridge")
    Container(intent_classifier, "Intent Classifier", "Java 21 / Spring Boot 4 / Port 9082", "Rule-based intent classification<br/>GREETING, QUESTION, COMMAND, SPAM, MENTION, REPORT")
    Container(policy_engine, "Policy Engine", "Java 21 / Spring Boot 4 / Port 9083", "Deterministic policy decisions<br/>ALLOW, BLOCK, FLAG, RESPOND, ESCALATE")
    Container(llm_orchestrator, "LLM Orchestrator", "Java 21 / Spring Boot 4 / Port 9084", "OpenAI-compatible LLM calls via LiteLLM proxy<br/>Runtime-configurable provider URL<br/>Cost tracking + prompt templates")
    Container(moderation_service, "Moderation Service", "Java 21 / Spring Boot 4 / Port 9085", "Toxicity filtering<br/>Content violation detection")

    ' Support Services (middle row)
    Container(conversation_context, "Conversation Context", "Java 21 / Spring Boot 4 / Port 9081", "Thread tracking<br/>Speaker roles<br/>Conversation history")
    Container(audit_service, "Audit Service", "Java 21 / Spring Boot 4 / Port 9086", "Structured logging<br/>Cost tracking<br/>Observability metrics")
    Container(admin_api, "Admin API", "Java 21 / Spring Boot 4 / Port 9087", "Admin endpoints<br/>JWT security<br/>Policy configuration")

    ' Infrastructure (bottom)
    ContainerDb(postgres, "PostgreSQL 16", "Database", "Persistent storage<br/>JSONB for event payloads")
    ContainerQueue(kafka, "Apache Kafka", "Event Backbone", "8 core topics<br/>telegram.raw.messages → messages.classified → policies.decisions")
}

' External Systems
System_Ext(telegram, "Telegram", "Telegram Messenger<br/>TDLib protocol")
System_Ext(llm_providers, "LiteLLM Proxy", "OpenAI-compatible proxy (local)<br/>Provider URL set via Admin UI")

' External Actor
Person(admin, "Platform Admin", "Administers policies<br/>Monitors platform")

' Telegram Integration
Rel(telegram, tdlib_adapter, "TDLib updates", "JNI/C++")
Rel(tdlib_adapter, telegram, "Send responses", "JNI/C++")

' Event Flow: Main Pipeline
Rel(tdlib_adapter, kafka, "Publish: telegram.raw.messages", "Async/JSON")
Rel(kafka, intent_classifier, "Consume: telegram.raw.messages", "Async/JSON")

Rel(intent_classifier, kafka, "Publish: messages.classified", "Async/JSON")
Rel(kafka, policy_engine, "Consume: messages.classified", "Async/JSON")

Rel(policy_engine, kafka, "Publish: policies.decisions", "Async/JSON")
Rel(kafka, llm_orchestrator, "Consume: policies.decisions", "Async/JSON")
Rel(kafka, moderation_service, "Consume: policies.decisions", "Async/JSON")

Rel(llm_orchestrator, kafka, "Publish: responses.generated", "Async/JSON")
Rel(moderation_service, kafka, "Publish: moderation.flags", "Async/JSON")

' Context & Audit (subscribed to all events)
Rel(kafka, conversation_context, "Consume: all events", "Async/JSON")
Rel(kafka, audit_service, "Consume: all events", "Async/JSON")

' LLM External Calls
Rel(llm_orchestrator, llm_providers, "Route requests", "HTTPS/REST")

' Admin API Connections
Rel(admin, admin_api, "Manage platform", "HTTPS/JWT")
Rel(admin_api, postgres, "Read/Write", "JDBC/R2DBC")
Rel(admin_api, policy_engine, "Configure policies", "REST/Internal")
Rel(admin_api, moderation_service, "Configure rules", "REST/Internal")
Rel(admin_api, audit_service, "Query logs", "REST/Internal")

' Database connections
Rel(tdlib_adapter, postgres, "Store messages", "R2DBC")
Rel(intent_classifier, postgres, "Store classifications", "R2DBC")
Rel(policy_engine, postgres, "Store decisions", "R2DBC")
Rel(llm_orchestrator, postgres, "Store costs/responses", "JPA")
Rel(moderation_service, postgres, "Store flags", "R2DBC")
Rel(conversation_context, postgres, "Store context", "R2DBC")
Rel(audit_service, postgres, "Store audit logs", "R2DBC")

' Response loop
Rel(kafka, tdlib_adapter, "Consume: responses.generated", "Async/JSON")

SHOW_LEGEND()
@enduml

