# Multi-stage build for emcip-tdlib-adapter
#
# Stage 1: Build TDLib from source with JNI bindings.
#   This produces libtdjni.so (and for arm64 via QEMU cross-build).
#   Build time: 15-30 min on first run; cached in subsequent builds.
#
# Stage 2: Build the Spring Boot application JAR.
#   Replaces the compile-time stub files in org.drinkless.tdlib with the
#   real Java sources generated by TDLib during Stage 1.
#
# Stage 3: Minimal JRE runtime image.
#   Copies only the JAR and native library from the build stages.

# --- Stage 1: Build TDLib native library ---
FROM eclipse-temurin:21-jdk AS tdlib-builder
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    g++ \
    zlib1g-dev \
    libssl-dev \
    gperf \
    php-cli \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Clone and build TDLib v1.8.29 with JNI support
RUN git clone --depth 1 --branch v1.8.29 https://github.com/tdlib/td /td
RUN cd /td && mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DTD_ENABLE_JNI=ON \
          -DJAVA_HOME=/opt/java/openjdk \
          .. && \
    cmake --build . --target tdjni -- -j$(nproc)

# Generate the real Java source files (TdApi.java, Client.java)
# TDLib ships a PHP script that splits the generated TL schema into Java files
RUN cd /td && php SplitSource.php || true
# The Java sources land in: /td/tdlib/java/org/drinkless/tdlib/

# --- Stage 2: Build Spring Boot application ---
FROM eclipse-temurin:21-jdk AS app-builder
WORKDIR /build

# Copy native library for reference during compilation (not strictly needed but explicit)
COPY --from=tdlib-builder /td/build/libtdjni.so /build/lib/

# Install Maven
RUN apt-get update && apt-get install -y maven --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

COPY pom.xml .

# Dependency pre-fetch (cached unless pom.xml changes)
RUN mvn dependency:go-offline -q

# Copy source and replace stub org.drinkless.tdlib classes with the real generated ones
COPY src ./src
COPY --from=tdlib-builder /td/tdlib/java/org/drinkless/tdlib/ \
     ./src/main/java/org/drinkless/tdlib/

# Build — the real TdApi.java and Client.java are now in the source tree
RUN mvn clean package -DskipTests -q

# --- Stage 3: Runtime ---
FROM eclipse-temurin:21-jre

# Install curl for health check and the shared TDLib dependency (libssl, zlib)
RUN apt-get update && apt-get install -y \
    curl \
    libssl3 \
    zlib1g \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copy native library from tdlib build stage
COPY --from=tdlib-builder /td/build/libtdjni.so /usr/local/lib/libtdjni.so

# Update dynamic linker cache
RUN ldconfig

WORKDIR /app

# Create non-root user
RUN groupadd -r emcip && useradd -r -g emcip emcip

# Copy application JAR
COPY --from=app-builder /build/target/*-exec.jar app.jar

# TDLib data volumes (session state persists across container restarts)
RUN mkdir -p /app/tdlib-db /app/tdlib-files && chown -R emcip:emcip /app

USER emcip

EXPOSE 9080

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -sf http://localhost:9080/actuator/health || exit 1

# java.library.path tells the JVM where to find libtdjni.so at runtime
ENTRYPOINT ["java", "-Djava.library.path=/usr/local/lib", "-jar", "app.jar"]
