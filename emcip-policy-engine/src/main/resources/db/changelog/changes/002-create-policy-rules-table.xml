<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="2" author="cascade">
        <createTable tableName="policy_rules" remarks="Configurable policy rules">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="target_intent" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="min_confidence" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="max_confidence" type="DOUBLE PRECISION">
                <constraints nullable="true"/>
            </column>
            <column name="action" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="priority" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="conditions" type="JSONB">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="true"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="rule_version" type="INTEGER" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_policy_rules_active" tableName="policy_rules">
            <column name="active"/>
        </createIndex>

        <createIndex indexName="idx_policy_rules_priority" tableName="policy_rules">
            <column name="priority"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
